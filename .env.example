# Required environment variables — set these in Vercel project settings (Settings → Environment Variables)
# Do NOT commit your .env file to git.

# PostHog analytics
# - API key: Settings → Personal API Keys → New (scopes: query:read, insight:read)
# - Project ID: numeric id from Project Settings → General
# - Host: us.posthog.com (default) or eu.posthog.com
POSTHOG_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_PROJECT_ID=430892
POSTHOG_HOST=us.posthog.com

# Groq API key (https://console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google PageSpeed Insights API key (Google Cloud Console)
PAGESPEED_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# X / Twitter posting (OAuth 1.0a)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_USERNAME=
